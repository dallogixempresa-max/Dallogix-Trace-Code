# Copie para .env e preencha todos os campos antes de subir o overlay de produção.
APP_ENV=production
TRACE_INSTALLATION_MODE=central
SESSION_SECURE=true
APP_URL=https://trace.example.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MYSQL_DATABASE=trace
MYSQL_USER=trace
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
TRACE_DEVICE_TOKEN=
CAMERA_DEVICE_TOKEN=
TRACE_VERSION=
TRACE_COMMIT=
TRACE_END_PRODUCT_ALERT_THRESHOLD=5
LOGIN_EMAIL_DOMAIN=example.com
LOGIN_EMAIL_BASE_DOMAIN=dallogix
UPDATE_CHANNEL=stable
# Retenção do estado do atualizador: a versão atual e os últimos pontos de recuperação.
TRACE_UPDATE_KEEP_RELEASES=3
TRACE_UPDATE_KEEP_BACKUPS=3
