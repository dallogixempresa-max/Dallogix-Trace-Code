# Substitua __APP_URL__ pela origem HTTPS antes de instalar.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=api_connections:10m;

server {
    listen 443 ssl;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_name _;
    root /var/www/interface;
    index index.html;
    # Só aceite o IP enviado pelo Cloudflare quando a conexão veio de uma
    # faixa oficial do proxy. Sem essa lista, qualquer cliente poderia forjar
    # X-Forwarded-For/CF-Connecting-IP e escapar do rate limit por origem.
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    client_max_body_size 6m;
    server_tokens off;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Só o listener HTTPS envia HSTS. Não habilite este cabeçalho no redirect HTTP.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /site.webmanifest {
        default_type application/manifest+json;
        try_files $uri =404;
    }

    # HTML, JS e CSS sempre revalidados: evita módulos desatualizados no navegador
    # após atualizações do sistema (o servidor responde 304 quando não mudou).
    location ~* \.(?:html|js|css)$ {
        expires epoch;
        try_files $uri =404;
    }

    location = /api/login.php {
        limit_req zone=login_limit burst=5 nodelay;
        limit_req_status 429;
        limit_conn api_connections 20;
        client_max_body_size 8k;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/servidor/api/login.php;
        fastcgi_pass php:9000;
    }

    location = /api/autenticacao/login.php {
        limit_req zone=login_limit burst=5 nodelay;
        limit_req_status 429;
        limit_conn api_connections 20;
        client_max_body_size 8k;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/servidor/api/autenticacao/login.php;
        fastcgi_pass php:9000;
    }

    location = /api/keyence_worker.php {
        limit_req zone=api_limit burst=5 nodelay;
        limit_req_status 429;
        limit_conn api_connections 10;
        client_max_body_size 12m;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/servidor/api/keyence_worker.php;
        fastcgi_pass php:9000;
    }

    location = /api/v1 {
        return 308 /api/v1/;
    }

    location ^~ /api/v1/ {
        limit_req zone=api_limit burst=80 nodelay;
        limit_req_status 429;
        limit_conn api_connections 40;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/servidor/api/v1/index.php;
        fastcgi_param SCRIPT_NAME /api/v1/index.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass php:9000;
    }

    location ~ ^/api/(.+\.php)$ {
        limit_req zone=api_limit burst=80 nodelay;
        limit_req_status 429;
        limit_conn api_connections 40;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/servidor/api/$1;
        fastcgi_pass php:9000;
    }

}

server {
    listen 80;
    server_name _;
    return 308 __APP_URL__$request_uri;
}
