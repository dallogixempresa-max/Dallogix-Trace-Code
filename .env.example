APP_ENV=local
# No PC industrial, mantenha "local" enquanto a interface usar http://127.0.0.1.
# Use APP_ENV=production somente com HTTPS local configurado.
TZ=America/Sao_Paulo
SESSION_SECURE=false
SESSION_IDLE_TIMEOUT=1800
# O PC industrial não recebe conexões externas; o gerenciamento remoto usa o servidor central.
WEB_BIND_ADDRESS=127.0.0.1
# Serviços técnicos permanecem apenas no PC industrial.
BIND_ADDRESS=127.0.0.1
# PC industrial: industrial. Bancada: industrial,simulation. Servidor central: deixe vazio.
COMPOSE_PROFILES=
# Produção: https://trace.dallogix.com
APP_URL=http://localhost
MYSQL_DATABASE=trace_local
MYSQL_USER=trace
# Nunca use valores de exemplo em uma instalação real. Gere credenciais
# aleatórias e mantenha este arquivo fora do controle de versão após copiar.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SYNC_REMOTE_URL=
# Opcional: endpoint que recebe {"events":[...]} em uma única requisição.
SYNC_REMOTE_BATCH_URL=
SYNC_REMOTE_TOKEN=
# URL base do servidor central para ativar esta instalação local.
# Se vazio, o Trace tenta derivar a URL de SYNC_REMOTE_BATCH_URL/SYNC_REMOTE_URL.
TRACE_CENTRAL_URL=
# Identifica explicitamente o PC industrial como instalação local.
TRACE_INSTALLATION_MODE=local
# Esta opção desativa a sincronização remota; use apenas em teste isolado.
TRACE_LOCAL_SIMULATION=0
# Confirma comandos fictícios apenas com TRACE_LOCAL_SIMULATION=1 e modo local.
TRACE_SIMULATOR_ONLY_COMMANDS=0
SYNC_BATCH_SIZE=50
SYNC_MAX_ATTEMPTS=5
SYNC_POLL_INTERVAL_SECONDS=1
TRACE_VERSION=
HEALTH_DEVICE_STALE_SECONDS=30
# O leitor Keyence publica heartbeat; cada tipo de dispositivo usa seu limite.
CLP_SIGNAL_LIMIT_SECONDS=3
SCANNER_SIGNAL_LIMIT_SECONDS=15
HEALTH_MIN_DISK_FREE_PERCENT=5
HEALTH_MAX_QUEUE_AGE_SECONDS=604800
# Opcional: autoriza X-Trace-Readiness-Token a consultar os detalhes técnicos.
TRACE_READINESS_TOKEN=
UPDATE_MANIFEST_URL=
UPDATE_MANIFEST_TOKEN=
# A chave pública de atualização está em servidor/configuracao/trace-update-public.pem.
# Em uma instalação Linux, informe o caminho absoluto desse arquivo.
UPDATE_PUBLIC_KEY_FILE=
UPDATE_CHANNEL=stable
# Retenção do estado do atualizador: a versão atual e os últimos pontos de recuperação.
TRACE_UPDATE_KEEP_RELEASES=3
TRACE_UPDATE_KEEP_BACKUPS=3
# Credenciais por dispositivo, provisionadas com scripts/provision_device.php.
TRACE_DEVICE_TOKEN=
# KEYENCE SR-X100W: leitura de código por TCP e fotos de erro por FTP.
# Configure os IPv4 fixos e credenciais antes de ativar KEYENCE_ENABLED=1.
# O worker inicia junto ao perfil industrial, mas fica inativo até essa opção ser ativada.
KEYENCE_ENABLED=0
KEYENCE_DEVICE_TOKEN=
KEYENCE_BIND_ADDRESS=127.0.0.1
KEYENCE_TCP_PORT=19000
KEYENCE_FTP_PORT=2121
KEYENCE_FTP_PASSIVE_START=21100
KEYENCE_FTP_PASSIVE_END=21109
KEYENCE_FTP_USER=trace-keyence
KEYENCE_FTP_PASSWORD=
KEYENCE_FTP_PASV_ADDRESS=
KEYENCE_FTP_ALLOWED_ADDRESS=
KEYENCE_TCP_ALLOWED_ADDRESS=
KEYENCE_IMAGE_MATCH_WINDOW_MS=3000
KEYENCE_IMAGE_SETTLE_MS=800
KEYENCE_IMAGE_MAX_AGE_MS=300000
KEYENCE_IMAGE_RECEIVE_TIMEOUT_MS=6000
# O leitor envia o código diretamente por TCP; o timeout decide quando uma
# falha de leitura fica sem foto e pode seguir para o relatório.
# CSRF e limite de tentativas de login/ativação permanecem ativos em todos os ambientes.

# Limites da API pública Central por minuto. Remova as linhas para usar os padrões.
# API_V1_READ_LIMIT_PER_KEY=120
# API_V1_READ_LIMIT_PER_COMPANY=600
# API_V1_WRITE_LIMIT_PER_KEY=20
# API_V1_WRITE_LIMIT_PER_COMPANY=120
LOGIN_EMAIL_DOMAIN=dallogix.local
LOGIN_EMAIL_BASE_DOMAIN=dallogix
IMAGE_RETENTION_DAYS=30
READING_RETENTION_DAYS=365
SENSOR_EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
SYNC_SENT_RETENTION_DAYS=30
ERROR_LOG_RETENTION_DAYS=365
TRACE_BACKUP_RETENTION_DAYS=30
MYSQL_PORT=3306
WEB_PORT=8080
NODE_RED_PORT=1880
# O perfil industrial exige autenticação no editor do Node-RED.
NODE_RED_ADMIN_USER=trace-admin
# Gere com `node-red admin hash-pw`; guarde somente o hash bcrypt entre aspas simples.
NODE_RED_ADMIN_PASSWORD_HASH=''
TRACE_DEBOUNCE_MS=400
# Aguarda o Keyence antes de registrar SEM_LEITURA e solicitar uma imagem de erro.
TRACE_SCANNER_NO_READ_TIMEOUT_MS=1500
# Alerta operacional quando restarem esta quantidade de sacas por produto.
TRACE_END_PRODUCT_ALERT_THRESHOLD=5
MODBUS_VIRTUAL_PORT=1502
# Sonda de leitura somente leitura do gateway. M2052 é um bit da área M; o
# perfil padrão lê a bobina por FC1, unidade 1, endereço Modbus 2052.
# Para outro CLP, substitua os três valores no .env antes de iniciar o gateway.
TRACE_MODBUS_UNIT_ID=1
TRACE_MODBUS_HEARTBEAT_FUNCTION=1
TRACE_MODBUS_HEARTBEAT_REGISTER=2052
TRACE_MODBUS_SENSOR_REGISTER=2052
# O padrão detecta borda de subida; use falling_edge ou toggle apenas conforme o Ladder.
TRACE_SENSOR_ACTIVE_LEVEL=1
TRACE_SENSOR_SIGNAL_MODE=rising_edge
